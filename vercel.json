{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "17 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/",
      "destination": "/api/index"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
